# Credential Learner Lab (role voclabs). Dipakai untuk Lambda dan Function URL.
# Ambil dari: Learner Lab -> Start Lab -> AWS Details -> AWS CLI: Show.
# Berubah setiap sesi lab (berlaku sekitar 4 jam), jadi blok ini harus diganti ulang.
[default]
aws_access_key_id=PASTE_ACCESS_KEY_ID_FROM_AWS_DETAILS
aws_secret_access_key=PASTE_SECRET_ACCESS_KEY_FROM_AWS_DETAILS
aws_session_token=PASTE_SESSION_TOKEN_FROM_AWS_DETAILS

# Credential IAM user (awsstudent). Dipakai untuk membuat tabel DynamoDB.
# Ambil dari panel credential sandbox. Tidak ada session token.
[iam]
aws_access_key_id=PASTE_IAM_USER_ACCESS_KEY_ID
aws_secret_access_key=PASTE_IAM_USER_SECRET_ACCESS_KEY
